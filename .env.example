# ── Modo de Comercio ─────────────────────────────
# "demo" = catalogo sem pagamentos (predefinido)
# "live" = pagamentos Stripe ativos
NEXT_PUBLIC_COMMERCE_MODE=demo

# ── Stripe (apenas em modo live) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_AUTOMATIC_TAX=true

# ── Site URL ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://liquidthesis.pt
